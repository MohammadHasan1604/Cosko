# COSKO MULTI-STORE ENTERPRISE SYSTEM — SUPABASE PRODUCTION ENVIRONMENT TEMPLATE

# Supabase Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous/Public API Key (Public Client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Secret (Server-Only — NEVER expose to browser or prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Automated Database Seeding Credentials
SEED_SUPER_ADMIN_EMAIL=cosko@gmail.com
SEED_SUPER_ADMIN_PASSWORD=your-secure-admin-password
SEED_STAFF_PASSWORD=your-secure-staff-password
