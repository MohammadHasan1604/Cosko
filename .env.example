# COSKO MULTI-STORE ENTERPRISE SYSTEM — ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------
# For Netlify / Multi-Device Cloud Production:
# The database MUST be a hosted, internet-accessible MySQL database (e.g., Aiven, PlanetScale, Railway, AWS RDS, or DigitalOcean)
# A local MySQL database (localhost:3306) on a developer's laptop will NOT be reachable from Netlify or mobile devices.

# 1. Authoritative MySQL Database Connection String
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslaccept=strict
DATABASE_URL="mysql://cosko_user:Cosko2026_SecurePass@your-hosted-mysql-host.com:3306/cosko_db?sslaccept=strict"

# 2. Server Secret Key for Session Signatures & JWT Auth Tokens (Must be a 32+ character random string)
AUTH_SECRET="cosko_enterprise_jwt_secret_key_production_2026_change_in_prod"

# 3. Application Public Base URL
NEXT_PUBLIC_APP_URL="https://cosko.netlify.app"

# 4. Optional: S3-Compatible Object Storage Credentials (Cloudflare R2 / AWS S3 / MinIO)
STORAGE_ENDPOINT="https://account-id.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="cosko-assets"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
