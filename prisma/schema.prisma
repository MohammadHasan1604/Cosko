datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. STORE HUBS
model StoreHub {
  id             String   @id @default(uuid())
  code           String   @unique @db.VarChar(16)
  name           String   @db.VarChar(128)
  city           String   @db.VarChar(64)
  address        String   @db.VarChar(255)
  managerName    String?  @map("manager_name") @db.VarChar(128)
  phone          String?  @db.VarChar(32)
  registersCount Int      @default(0) @map("registers_count")
  skusCount      Int      @default(0) @map("skus_count")
  monthlyRevenue Decimal  @default(0.00) @map("monthly_revenue") @db.Decimal(15, 2)
  monthlyTarget  Decimal? @map("monthly_target") @db.Decimal(15, 2)
  status         String   @default("Active") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("stores")
}

// 2. USER ACCOUNTS & PROFILES
model UserAccount {
  id                 String   @id @default(uuid())
  email              String   @unique @db.VarChar(128)
  passwordHash       String   @map("password_hash") @db.VarChar(255)
  name               String   @db.VarChar(128)
  phone              String?  @db.VarChar(32)
  role               String   @default("Store Manager") @db.VarChar(32)
  securityLevel      Int      @default(80) @map("security_level")
  storeScope         String   @default("BLR") @map("store_scope") @db.VarChar(64)
  status             String   @default("Active") @db.VarChar(16)
  shiftStatus        String   @default("On Shift") @map("shift_status") @db.VarChar(16)
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  avatarUrl          String?  @map("avatar_url") @db.LongText
  lastLogin          DateTime? @map("last_login")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  storeAssignments UserStoreAssignment[]
  permissionOverrides UserPermissionOverride[]

  @@map("users")
}

// 3. USER STORE ASSIGNMENTS
model UserStoreAssignment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  storeCode String   @map("store_code") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storeCode])
  @@map("user_store_assignments")
}

// 4. ROLES & PERMISSIONS
model Role {
  id            String   @id @default(uuid())
  name          String   @unique @db.VarChar(64)
  securityLevel Int      @default(10) @map("security_level")
  description   String?  @db.VarChar(255)
  isSystemRole  Boolean  @default(true) @map("is_system_role")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("roles")
}

model Permission {
  id               String   @id @default(uuid())
  code             String   @unique @db.VarChar(128)
  name             String   @db.VarChar(128)
  category         String   @db.VarChar(64)
  isProtected      Boolean  @default(false) @map("is_protected")
  minSecurityLevel Int      @default(10) @map("min_security_level")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("permissions")
}

model UserPermissionOverride {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  permissionCode String   @map("permission_code") @db.VarChar(128)
  overrideType   String   @map("override_type") @db.VarChar(8)
  createdAt      DateTime @default(now()) @map("created_at")

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionCode])
  @@map("user_permission_overrides")
}

// 4B. CATEGORIES & TAXONOMY
model Category {
  id               String    @id @default(uuid())
  name             String    @db.VarChar(128)
  slug             String    @unique @db.VarChar(128)
  parentCategoryId String?   @map("parent_category_id")
  categoryType     String    @default("Product") @map("category_type") @db.VarChar(64)
  description      String?   @db.VarChar(255)
  imageUrl         String?   @map("image_url") @db.LongText
  icon             String?   @db.VarChar(64)
  status           String    @default("Active") @db.VarChar(16)
  sortOrder        Int       @default(0) @map("sort_order")
  createdBy        String?   @map("created_by") @db.VarChar(128)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  @@index([parentCategoryId])
  @@index([categoryType])
  @@index([status])
  @@map("categories")
}

// 5. PRODUCTS & CATALOG
model Product {
  id               String   @id @default(uuid())
  sku              String   @unique @db.VarChar(64)
  barcode          String?  @db.VarChar(64)
  name             String   @db.VarChar(160)
  brand            String?  @db.VarChar(64)
  model            String?  @db.VarChar(64)
  category         String   @db.VarChar(64)
  subcategory      String?  @db.VarChar(64)
  baseCostPrice    Decimal  @default(0) @map("base_cost_price") @db.Decimal(12, 2)
  baseSellingPrice Decimal  @default(0) @map("base_selling_price") @db.Decimal(12, 2)
  mrp              Decimal? @db.Decimal(12, 2)
  gstRate          Decimal  @default(0) @map("gst_rate") @db.Decimal(5, 2)
  warrantyMonths   Int      @default(0) @map("warranty_months")
  imageUrl         String?  @map("image_url") @db.LongText
  description      String?  @db.Text
  status           String   @default("active") @db.VarChar(16)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  inventoryItems  Inventory[]
  ledgerEntries   InventoryLedger[]
  transferItems   StockTransferItem[]
  poItems         PurchaseOrderItem[]
  saleItems       SalesOrderItem[]

  @@index([category])
  @@index([brand])
  @@map("products")
}

// 6. INVENTORY
model Inventory {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  storeCode   String   @map("store_code") @db.VarChar(16)
  qtyOnHand   Int      @default(0) @map("qty_on_hand")
  qtyReserved Int      @default(0) @map("qty_reserved")
  reorderPt   Int      @default(5) @map("reorder_pt")
  maxStock    Int      @default(50) @map("max_stock")
  shelfLoc    String?  @map("shelf_loc") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, storeCode])
  @@index([storeCode])
  @@map("inventory")
}

// 7. INVENTORY LEDGER
model InventoryLedger {
  id                  String   @id @default(uuid())
  productId           String   @map("product_id")
  storeCode           String   @map("store_code") @db.VarChar(16)
  refNo               String   @map("ref_no") @db.VarChar(64)
  type                String   @db.VarChar(32)
  qtyChange           Int      @map("qty_change")
  costPerUnit         Decimal  @map("cost_per_unit") @db.Decimal(12, 2)
  sellingPricePerUnit Decimal? @map("selling_price_per_unit") @db.Decimal(12, 2)
  balanceAfter        Int      @map("balance_after")
  notes               String?  @db.VarChar(255)
  createdBy           String?  @map("created_by") @db.VarChar(128)
  createdAt           DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeCode])
  @@index([refNo])
  @@map("inventory_ledger")
}

// 8. STOCK TRANSFERS & CENTRAL PROFIT
model StockTransfer {
  id                String   @id @default(uuid())
  transferNo        String   @unique @map("transfer_no") @db.VarChar(64)
  sourceStore       String   @map("source_store") @db.VarChar(16)
  destStore         String   @map("dest_store") @db.VarChar(16)
  status            String   @default("Received") @db.VarChar(32)
  shipDate          DateTime @default(now()) @map("ship_date")
  receiveDate       DateTime? @map("receive_date")
  requestedBy       String   @map("requested_by") @db.VarChar(128)
  receivedBy        String?  @map("received_by") @db.VarChar(128)
  totalUnits        Int      @map("total_units")
  totalCost         Decimal  @map("total_cost") @db.Decimal(15, 2)
  totalTransferValue Decimal @map("total_transfer_value") @db.Decimal(15, 2)
  grossProfit       Decimal  @map("gross_profit") @db.Decimal(15, 2)
  notes             String?  @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  items StockTransferItem[]

  @@index([sourceStore])
  @@index([destStore])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                  String  @id @default(uuid())
  transferId          String  @map("transfer_id")
  productId           String  @map("product_id")
  qty                 Int
  costPerUnit         Decimal @map("cost_per_unit") @db.Decimal(12, 2)
  transferPricePerUnit Decimal @map("transfer_price_per_unit") @db.Decimal(12, 2)
  lineTotalCost       Decimal @map("line_total_cost") @db.Decimal(12, 2)
  lineTotalValue      Decimal @map("line_total_value") @db.Decimal(12, 2)
  lineProfit          Decimal @map("line_profit") @db.Decimal(12, 2)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_transfer_items")
}

// 9. CUSTOMERS & REPAIRS
model Customer {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(128)
  phone           String   @db.VarChar(32)
  normalizedPhone String   @map("normalized_phone") @db.VarChar(32)
  email           String?  @db.VarChar(128)
  city            String   @default("Bengaluru") @db.VarChar(64)
  address         String?  @db.VarChar(255)
  creditBalance   Decimal  @default(0.00) @map("credit_balance") @db.Decimal(12, 2)
  totalSpent      Decimal  @default(0.00) @map("total_spent") @db.Decimal(15, 2)
  totalOrders     Int      @default(0) @map("total_orders")
  status          String   @default("Active") @db.VarChar(16)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  repairs RepairEnquiry[]
  sales   SalesOrder[]
  externalLinks CustomerExternalLink[]

  @@index([normalizedPhone])
  @@map("customers")
}

model CustomerExternalLink {
  id                   String    @id @default(uuid())
  coskoCustomerId      String?   @map("cosko_customer_id")
  sourceSystem         String    @default("LEGACY_MYSQL_DB") @map("source_system") @db.VarChar(64)
  externalCustomerId   String    @map("external_customer_id") @db.VarChar(64)
  externalCustomerName String    @map("external_customer_name") @db.VarChar(128)
  normalizedMobile     String    @map("normalized_mobile") @db.VarChar(32)
  linkStatus           String    @default("AUTO_MATCHED") @map("link_status") @db.VarChar(32)
  matchType            String    @default("EXACT_PHONE") @map("match_type") @db.VarChar(32)
  verifiedBy           String?   @map("verified_by") @db.VarChar(128)
  verifiedAt           DateTime? @map("verified_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [coskoCustomerId], references: [id], onDelete: SetNull)

  @@index([normalizedMobile])
  @@index([externalCustomerId])
  @@index([linkStatus])
  @@map("customer_external_links")
}

model RepairEnquiry {
  id               String   @id @default(uuid())
  ticketNo         String   @unique @map("ticket_no") @db.VarChar(32)
  customerId       String?  @map("customer_id")
  customerName     String   @map("customer_name") @db.VarChar(128)
  customerPhone    String   @map("customer_phone") @db.VarChar(32)
  normalizedPhone  String   @map("normalized_phone") @db.VarChar(32)
  deviceName       String   @map("device_name") @db.VarChar(128)
  issueDescription String   @map("issue_description") @db.VarChar(255)
  estimatedCost    Decimal  @map("estimated_cost") @db.Decimal(12, 2)
  status           String   @default("Pending Diagnosis") @db.VarChar(32)
  assignedTech     String?  @map("assigned_tech") @db.VarChar(128)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([normalizedPhone])
  @@map("repair_enquiries")
}

// 10. VENDORS & PURCHASES
model Vendor {
  id            String   @id @default(uuid())
  code          String   @unique @db.VarChar(32)
  name          String   @db.VarChar(128)
  contactPerson String   @map("contact_person") @db.VarChar(128)
  email         String   @db.VarChar(128)
  phone         String   @db.VarChar(32)
  city          String   @db.VarChar(64)
  address       String?  @db.VarChar(255)
  categories    String   @db.VarChar(255)
  gstin         String?  @default("") @db.VarChar(32)
  paymentTerms  String   @default("Net 30") @map("payment_terms") @db.VarChar(32)
  leadTimeDays  Int?     @map("lead_time_days")
  rating        Decimal? @db.Decimal(3, 1)
  status        String   @default("Active") @db.VarChar(16)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  purchases PurchaseOrder[]

  @@map("vendors")
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  poNo         String    @unique @map("po_no") @db.VarChar(64)
  invoiceNo    String?   @map("invoice_no") @db.VarChar(64)
  vendorId     String    @map("vendor_id")
  storeCode    String    @map("store_code") @db.VarChar(16)
  orderDate    DateTime  @default(now()) @map("order_date")
  expectedDate DateTime? @map("expected_date")
  dueDate      DateTime? @map("due_date")
  receivedDate DateTime? @map("received_date")
  totalCost    Decimal   @map("total_cost") @db.Decimal(15, 2)
  paidAmount   Decimal   @default(0) @map("paid_amount") @db.Decimal(15, 2)
  creditAmount Decimal   @default(0) @map("credit_amount") @db.Decimal(15, 2)
  status       String    @default("Ordered") @db.VarChar(32)
  paymentStatus String   @default("Unpaid") @map("payment_status") @db.VarChar(32)
  createdBy    String    @map("created_by") @db.VarChar(128)
  notes        String?   @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  vendor   Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items    PurchaseOrderItem[]
  payments PurchasePayment[]
  grns     GoodsReceivedNote[]

  @@index([storeCode])
  @@map("purchases")
}

// Purchase Payment Records
model PurchasePayment {
  id            String   @id @default(uuid())
  purchaseId    String   @map("purchase_id")
  voucherNo     String?  @map("voucher_no") @db.VarChar(64)
  amount        Decimal  @db.Decimal(15, 2)
  paymentDate   DateTime @default(now()) @map("payment_date")
  paymentMethod String   @default("Bank Transfer") @map("payment_method") @db.VarChar(32)
  referenceNo   String?  @map("reference_no") @db.VarChar(64)
  receiptUrl    String?  @map("receipt_url") @db.LongText
  notes         String?  @db.VarChar(255)
  recordedBy    String   @map("recorded_by") @db.VarChar(128)
  createdAt     DateTime @default(now()) @map("created_at")

  purchase PurchaseOrder @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@map("purchase_payments")
}

// Goods Received Notes
model GoodsReceivedNote {
  id           String   @id @default(uuid())
  grnNo        String   @unique @map("grn_no") @db.VarChar(64)
  purchaseId   String   @map("purchase_id")
  storeCode    String   @map("store_code") @db.VarChar(16)
  receivedDate DateTime @default(now()) @map("received_date")
  receivedBy   String   @map("received_by") @db.VarChar(128)
  notes        String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  purchase PurchaseOrder @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@map("goods_received_notes")
}

model PurchaseOrderItem {
  id          String  @id @default(uuid())
  poId        String  @map("po_id")
  productId   String  @map("product_id")
  qtyOrdered  Int     @map("qty_ordered")
  qtyReceived Int     @map("qty_received")
  unitCost    Decimal @map("unit_cost") @db.Decimal(12, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)

  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("purchase_items")
}

// 11. SALES & POS ORDERS
model SalesOrder {
  id             String   @id @default(uuid())
  orderNo        String   @unique @map("order_no") @db.VarChar(64)
  storeCode      String   @map("store_code") @db.VarChar(16)
  customerId     String?  @map("customer_id")
  customerName   String   @map("customer_name") @db.VarChar(128)
  customerPhone  String   @map("customer_phone") @db.VarChar(32)
  subtotal       Decimal  @db.Decimal(15, 2)
  taxAmount      Decimal  @map("tax_amount") @db.Decimal(15, 2)
  discountAmount Decimal  @default(0.00) @map("discount_amount") @db.Decimal(15, 2)
  grandTotal     Decimal  @map("grand_total") @db.Decimal(15, 2)
  totalCost      Decimal  @map("total_cost") @db.Decimal(15, 2)
  grossProfit    Decimal  @map("gross_profit") @db.Decimal(15, 2)
  paymentMethod  String   @default("UPI") @map("payment_method") @db.VarChar(32)
  status         String   @default("Completed") @db.VarChar(16)
  cashierName    String   @map("cashier_name") @db.VarChar(128)
  photosJson     String?  @map("photos_json") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  customer Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    SalesOrderItem[]

  @@index([storeCode])
  @@index([orderNo])
  @@map("sales")
}

model SalesOrderItem {
  id              String  @id @default(uuid())
  orderId         String  @map("order_id")
  productId       String  @map("product_id")
  productName     String  @map("product_name") @db.VarChar(160)
  sku             String  @db.VarChar(64)
  qty             Int
  unitPrice       Decimal @map("unit_price") @db.Decimal(12, 2)
  unitCost        Decimal @map("unit_cost") @db.Decimal(12, 2)
  discountPercent Decimal @default(0.00) @map("discount_percent") @db.Decimal(5, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(12, 2)
  lineProfit      Decimal @map("line_profit") @db.Decimal(12, 2)

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

// 12. EXPENSES & CENTRAL EXPENSES
model Expense {
  id            String   @id @default(uuid())
  expenseNo     String   @unique @map("expense_no") @db.VarChar(64)
  storeCode     String   @map("store_code") @db.VarChar(16)
  category      String   @db.VarChar(64)
  amount        Decimal  @db.Decimal(12, 2)
  description   String   @db.VarChar(255)
  paymentMethod String   @default("Bank Transfer") @map("payment_method") @db.VarChar(32)
  approvedBy    String   @map("approved_by") @db.VarChar(128)
  date          DateTime @default(now())
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([storeCode])
  @@map("expenses")
}

model CentralExpense {
  id            String   @id @default(uuid())
  expenseNo     String   @unique @map("expense_no") @db.VarChar(64)
  category      String   @db.VarChar(64)
  amount        Decimal  @db.Decimal(12, 2)
  description   String   @db.VarChar(255)
  paymentMethod String   @default("Bank Transfer") @map("payment_method") @db.VarChar(32)
  approvedBy    String   @map("approved_by") @db.VarChar(128)
  date          DateTime @default(now())
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("central_expenses")
}

// 13. AUDIT LOGS
model AuditLog {
  id        String   @id @default(uuid())
  module    String   @db.VarChar(64)
  action    String   @db.VarChar(128)
  details   String   @db.Text
  userEmail String   @map("user_email") @db.VarChar(128)
  userRole  String   @map("user_role") @db.VarChar(64)
  storeCode String   @map("store_code") @db.VarChar(16)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([module])
  @@index([userEmail])
  @@map("audit_logs")
}

// 14. BRANDING & SYSTEM SETTINGS
model BrandingSetting {
  id              String   @id @default("cosko_branding_config")
  appName         String   @default("COSKO") @map("app_name") @db.VarChar(128)
  logoUrl         String?  @map("logo_url") @db.LongText
  faviconUrl      String?  @map("favicon_url") @db.LongText
  tagline         String   @default("Multi-Store Enterprise Retail & POS System") @db.VarChar(255)
  supportEmail    String   @default("support@cosko.com") @map("support_email") @db.VarChar(128)
  supportPhone    String?  @map("support_phone") @db.VarChar(32)
  businessName    String?  @map("business_name") @db.VarChar(255)
  businessAddress String?  @map("business_address") @db.Text
  city            String?  @db.VarChar(64)
  state           String?  @db.VarChar(64)
  pincode         String?  @db.VarChar(10)
  baseCurrency    String   @default("INR (₹)") @map("base_currency") @db.VarChar(32)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("branding_settings")
}

// 14B. SYSTEM SETTINGS — Tax, Invoice, Security, Alerts (Single-Row Config)
model SystemSettings {
  id                    String   @id @default("cosko_system_config")
  // ─── GST / Tax ───
  gstin                 String?  @db.VarChar(15)
  legalBusinessName     String?  @map("legal_business_name") @db.VarChar(255)
  tradeName             String?  @map("trade_name") @db.VarChar(255)
  gstState              String?  @map("gst_state") @db.VarChar(64)
  gstStateCode          String?  @map("gst_state_code") @db.VarChar(2)
  gstRegistrationType   String   @default("Regular") @map("gst_registration_type") @db.VarChar(32)
  defaultTaxRate        Decimal  @default(18) @map("default_tax_rate") @db.Decimal(5, 2)
  hsnMandatory          Boolean  @default(false) @map("hsn_mandatory")
  enableReverseCharge   Boolean  @default(false) @map("enable_reverse_charge")
  gstBusinessAddress    String?  @map("gst_business_address") @db.Text
  // ─── Invoice Template ───
  invoiceHeader         String   @default("COSKO Retail Enterprise") @map("invoice_header") @db.VarChar(255)
  invoiceFooter         String   @default("Thank you for shopping with us! Goods once sold cannot be returned without original receipt.") @map("invoice_footer") @db.VarChar(500)
  invoiceTerms          String?  @map("invoice_terms") @db.Text
  invoiceAccentColor    String   @default("primary") @map("invoice_accent_color") @db.VarChar(32)
  watermarkOpacity      Int      @default(5) @map("watermark_opacity")
  showStoreAddress      Boolean  @default(true) @map("show_store_address")
  invoiceTemplateUrl    String?  @map("invoice_template_url") @db.LongText
  invoiceTemplateVersion Int     @default(1) @map("invoice_template_version")
  invoiceFieldMapping   String?  @map("invoice_field_mapping") @db.Text
  showPaymentQr         Boolean  @default(false) @map("show_payment_qr")
  paymentUpiId          String?  @map("payment_upi_id") @db.VarChar(128)
  paymentBankDetails    String?  @map("payment_bank_details") @db.Text
  // ─── Security ───
  sessionTimeoutMins    Int      @default(30) @map("session_timeout_mins")
  maxLoginAttempts      Int      @default(5) @map("max_login_attempts")
  enforcePasswordPolicy Boolean  @default(true) @map("enforce_password_policy")
  sensitiveActionConfirm Boolean @default(true) @map("sensitive_action_confirm")
  // ─── Alerts ───
  lowStockAlerts        Boolean  @default(true) @map("low_stock_alerts")
  lowStockThreshold     Int      @default(5) @map("low_stock_threshold")
  overduePaymentAlerts  Boolean  @default(true) @map("overdue_payment_alerts")
  overdueThresholdDays  Int      @default(30) @map("overdue_threshold_days")
  dailySalesDigest      Boolean  @default(false) @map("daily_sales_digest")
  securityEventAlerts   Boolean  @default(true) @map("security_event_alerts")
  alertRecipientEmails  String?  @map("alert_recipient_emails") @db.Text

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// 15. SECURE LEGACY DATA CONNECTIONS
model LegacyDataSourceConfig {
  id                 String    @id @default("legacy_customer_repair_db")
  name               String    @default("Legacy Customer & Repair Database")
  dbType             String    @default("MySQL") @map("db_type") @db.VarChar(32)
  host               String    @default("127.0.0.1") @db.VarChar(128)
  port               Int       @default(3306)
  databaseName       String    @default("cosko_legacy_store") @map("database_name") @db.VarChar(64)
  username           String    @default("cosko_legacy_reader") @db.VarChar(64)
  encryptedPassword   String?   @map("encrypted_password") @db.Text
  sslMode            String    @default("Preferred") @map("ssl_mode") @db.VarChar(32)
  connectionTimeout  Int       @default(2500) @map("connection_timeout")
  readTimeout        Int       @default(3000) @map("read_timeout")
  status             String    @default("Connected") @db.VarChar(32)
  isReadOnly         Boolean   @default(true) @map("is_read_only")
  customerTable      String    @default("legacy_customers") @map("customer_table") @db.VarChar(64)
  repairTable        String    @default("legacy_repair_enquiries") @map("repair_table") @db.VarChar(64)
  fieldMappings      String?   @map("field_mappings") @db.Text
  lastCheckedAt      DateTime? @map("last_checked_at")
  lastLatencyMs      Int?      @default(12) @map("last_latency_ms")
  updatedBy          String?   @map("updated_by") @db.VarChar(128)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("legacy_data_source_configs")
}

// 16. FINANCIAL & GENERAL LEDGER
model FinancialLedgerEntry {
  id              String   @id @default(uuid())
  entryNo         String   @unique @map("entry_no") @db.VarChar(64)
  entryDate       DateTime @default(now()) @map("entry_date")
  storeCode       String   @map("store_code") @db.VarChar(16)
  accountCategory String   @map("account_category") @db.VarChar(32) // REVENUE, COGS, OPERATING_EXPENSE, CENTRAL_EXPENSE, TRANSFER_MARKUP, ASSET, LIABILITY
  accountName     String   @map("account_name") @db.VarChar(64)
  debit           Decimal  @default(0.00) @db.Decimal(15, 2)
  credit          Decimal  @default(0.00) @db.Decimal(15, 2)
  amount          Decimal  @db.Decimal(15, 2)
  refType         String   @map("ref_type") @db.VarChar(32) // SALE, PURCHASE_GRN, VENDOR_PAYMENT, EXPENSE, STOCK_TRANSFER, INVENTORY_ADJUSTMENT
  refId           String?  @map("ref_id") @db.VarChar(64)
  refNo           String   @map("ref_no") @db.VarChar(64)
  entityName      String?  @map("entity_name") @db.VarChar(128)
  description     String   @db.VarChar(255)
  isEliminated    Boolean  @default(false) @map("is_eliminated")
  metadataJson    String?  @map("metadata_json") @db.Text
  createdBy       String   @map("created_by") @db.VarChar(128)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([storeCode])
  @@index([entryDate])
  @@index([accountCategory])
  @@index([refType])
  @@index([refNo])
  @@map("financial_ledger")
}
